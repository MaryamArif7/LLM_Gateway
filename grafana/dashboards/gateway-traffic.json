      "type": "timeseries",
      "title": "Usage rows by how they were recorded",
      "description": "published (sent to Kafka), direct_db (Kafka is off), fallback_db (Kafka was down or slow, Postgres was written directly), failed (the row was lost).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result)(rate(gateway_usage_events_total[$__rate_interval]))",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{result}}"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": {
