            "uid": "gateway-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT avg(cost_usd) AS \"avg cost\" FROM grafana_request_logs WHERE $__timeFilter(created_at) AND NOT cache_hit AND NOT failed"
