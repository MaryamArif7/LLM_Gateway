          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT classification AS metric, sum(cost_usd) AS value FROM grafana_request_logs WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC"
