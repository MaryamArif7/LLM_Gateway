            "type": "postgres",
            "uid": "gateway-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(sum(cost_usd), 0) AS \"spend\" FROM grafana_request_logs WHERE $__timeFilter(created_at)"
