    {
      "id": 10,
      "type": "timeseries",
      "title": "Latency p50 and p95 by provider",
      "description": "Only requests that reached a provider.",
      "datasource": {
        "type": "postgres",
        "uid": "gateway-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gateway-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at,$__interval), provider || ' p50' AS metric, percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS value FROM grafana_request_logs WHERE $__timeFilter(created_at) AND NOT cache_hit AND NOT failed GROUP BY 1, 2 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "gateway-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at,$__interval), provider || ' p95' AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS value FROM grafana_request_logs WHERE $__timeFilter(created_at) AND NOT cache_hit AND NOT failed GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
