          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at,$__interval), provider AS metric, sum(cost_usd) AS value FROM grafana_request_logs WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
