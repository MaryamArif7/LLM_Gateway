    {
      "id": 12,
      "type": "table",
      "title": "By model",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gateway-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gateway-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT model, provider, count(*) AS requests, COALESCE(sum(cost_usd), 0) AS cost_usd, avg(latency_ms) FILTER (WHERE NOT cache_hit AND NOT failed) AS avg_latency_ms, avg(cache_hit::int) AS cache_hit_rate, avg(failed::int) AS failure_rate FROM grafana_request_logs WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 4 DESC"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 20
      },
