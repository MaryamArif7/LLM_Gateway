# Provider API keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Infra
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway
REDIS_URL=redis://redis:6379/0

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Cache
CACHE_TTL_SECONDS=3600

# App
ENV=development
LOG_LEVEL=info
