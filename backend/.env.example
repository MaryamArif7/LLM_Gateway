# Server-held provider keys — optional now, kept only as a local-dev fallback.
# Real requests use each user's own key from the provider key vault (BYOK).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Secret that encrypts every user's stored provider keys at rest. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Infra
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway
REDIS_URL=redis://redis:6379/0

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Cache
CACHE_TTL_SECONDS=3600

# App
ENV=development
LOG_LEVEL=info
